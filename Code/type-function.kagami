open sys

type Expr {
	| Number(i int)
	| Addition(expr1 Expr, expr2 Expr)
	| Multiplication(expr1 Expr, expr2 Expr)
	fn evaluate() {
		match self {
			| Number(value) return value
			| Addition(left, right) return left.evaluate() + right.evaluate()
			| Multiplication(left, right) return left.evaluate() * right.evaluate()
		}
	}
}

let five = Expr.number(5)
let four = Expr.number(4)
let sum = Expr.addition(five, four)
let product = sum.evaluate()