open sys

var data = ["lemon", "lime", "grape", "apple", "pear", "watermelon", "canteloupe", "honeydew", "orange", "grapefruit"]

func make_producer(collection, excludes) {
	return item for item in collection if item not in excludes
}

var iter = make_producer(data, {"apple", "orange", "honeydew"})
for fruit in iter {
	println(fruit)
}