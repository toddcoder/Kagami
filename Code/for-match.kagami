open sys

#pragma ALLOW_PRINT_STATEMENT true

class Subjects(var physics: _ string)

class Chemistry(var physics: _ string, equations: _ string) is Subjects(physics: physics);

class Maths(var physics: _ string, formulae: _ string) is Subjects(physics: physics);

let sa = [
	Chemistry(physics: "solid physics", equations: "Hertz"),
	Maths(physics: "Fluid Dynamics", formulae: "Giga Hertz")
]

for match sa {
	| Chemistry chemistry {
		println $"Chemistry topics are: $chemistry.physics, $chemistry.equations"
	}
	| Maths maths {
		println $"Maths topics are: $maths.physics, $maths.formulae"
	}
}

var examples = [12, 3.14159, "Example for any", Chemistry(physics: "solid physics", equations: "Hertz"), 1 + 1i]
for match item in examples {
	| Int someInt => println $"Integer value is $someInt"
	| Float someFloat if someFloat > 0 => println $"Pi value is $someFloat"
	| String someString => println someString
	| Chemistry chemistry => println $"Topics '$chemistry.physics', $chemistry.equations"
	| _ => println item
}