open sys

let things = [0, 0.0, 1, 1.0, -2.0, "foobar", [10.0, 42.0]]
for thing in things {
	match thing {
		when 0 => println("zero as an Int")
		when 0.0 => println("zero as a Float")
		when someInt: Int => println($"an integer value of (someInt)")
		when someFloat: Float if someFloat > 0 => println($"positive float of (someFloat)")
		when Float => println("some other float")
		when someString: String => println($"a string value of (someString)")
		when [x: Float, y: Float] => println($"an \(x, y) point at (x), (y)")
		when _ => println($"something else: (~thing)")
	}
}