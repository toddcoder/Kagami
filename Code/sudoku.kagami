open sys

var sudoku = "0000000750000800940005006000100002000009000570060" ~
	"03040001000023080000006063240000"
sudoku .= .translate({'0': ' '})

let separator = "+---+---+---+"
var index = 0

var array = [i for i in sudoku] %(9, 9)
for (i, line) in #^array {
	if i %% 3 do println(separator)
	print("|")
	for trio in line.by(3) {
		print(trio.join("") ~ "|")
	}
	println()
}
println(separator)