open sys

class Worker {
	fn work() => println("get work done")
	fn analyze() => println("analyze...")
	fn writeReport() => println("get report written")
}

class Export {
	fn analyze() => println("expert analysis...")
}

class Manager {}
delegate Export = Export()
delegate Worker = Worker()

var bernie = Manager()
bernie.analyze()
bernie.work()
bernie.writeReport()