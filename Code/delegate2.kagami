open sys

class Worker {
	func work() <- println("get work done")
	func analyze() <- println("analyze...")
	func writeReport() <- println("get report written")
}

class Export {
	func analyze() <- println("expert analysis...")
}

class Manager {}
delegate Export = Export()
delegate Worker = Worker()

var bernie = Manager()
bernie.analyze()
bernie.work()
bernie.writeReport()