open sys

inclusion Polygon {
	required var width int
	required var height int
	required fn area() int
	fn printArea() => println(self.class.name, area())
}

class Rectangle(var width int, var height int) {
	include Polygon
	fn area() int => width * height
}

class Triangle(var width int, var height int) {
	include Polygon
	fn area() int => width * height / 2f
}

var rectangle = Rectangle(4, 5)
var triangle = Triangle(4, 5)
rectangle.printArea()
triangle.printArea()