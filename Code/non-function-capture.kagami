open sys

type Expr {
	| Var(name)
	| Numeric(number)
	| UnOp(op, args)
	| BinOp(op, left, right)
}

match simplifyTop()
	| UnOp("-", UnOp("-", e)) return e
	| BinOp("+", e, Numeric(0)) return e
	| BinOp("*", e, Numeric(1)) return e
	| e return e

println(simplifyTop(UnOp("-", UnOp("-", Numeric(42)))))