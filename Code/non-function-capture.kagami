open sys

enum Expr {
	when Var(name)
	when Numberx(number)
	when UnOp(op, args)
	when BinOp(op, left, right)
}

func simplifyTop()
	when UnOp("-", UnOp("-", e)) return e
	when BinOp("+", e, Numberx(0)) return e
	when BinOp("*", e, Numberx(1)) return e
	when e return e

simplifyTop(Expr.UnOp("-", Expr.UnOp("-", Expr.Numberx(42))))