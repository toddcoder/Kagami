open sys

enum Expr {
	when Var(name)
	when Number`(number)
	when UnOp(op, args)
	when BinOp(op, left, right)
}

func simplifyTop()
	when UnOp("-", UnOp("-", e)) return e
	when BinOp("+", e, Number`(0)) return e
	when BinOp("*", e, Number`(1)) return e
	when e return e

simplifyTop(Expr.UnOp("-", Expr.UnOp("-", Expr.Number`(42))))