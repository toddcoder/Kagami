open sys

enum Command {
	| Open
	| Closed
	| Pending
	| Approved
	| Denied
}

execute(Open)
func execute(command Command) {
	match command {
		| Open return println("open")
		| Closed return println("closed")
		| Pending return println("pending")
		| Approved return println("approved")
		| Denied return println("denied")
	}
}