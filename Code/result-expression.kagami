open sys

#pragma ALLOW_PRINT_STATEMENT true

fn decimalDigitValue(c char) result {
	return c in ('0' to '9') !- /int c - /int '0' : "out of range"
}

let res1 = decimalDigitValue('5')
if res1 {
	println res1
}
else {
	println "error: " ~ res1
}

let res2 = decimalDigitValue('a')
if res2 {
	println res2
}
else {
	println "error: " ~ res2
}