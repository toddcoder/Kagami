open sys

class Matrix {
	var matrix = {:}
	func [](x int) := matrix[x]&
	func []=(x int, value string) := matrix[x] = value
	func string := ~matrix
}

var matrix = Matrix()
matrix[10] = "ten"
matrix[42] = "forty-two"
println(matrix[10])
println(matrix[42])
matrix[99] = "ninety"
matrix[99] ~= "-nine"

var a = [1, 2, 2, 4, 5]
a[2] += 1
println(a)