open sys

class Worker1(name string) {
	fn identify() => $"(name) is a worker"
}

class Worker2(workerId int) {
	fn getId() => $"the id = (workerId)"
}

class Worker(name string, workerId int) uses Worker1(name), Worker2(workerId)

var worker = Worker("Zoe", 16)
println(worker.identify())
println(worker.getId())