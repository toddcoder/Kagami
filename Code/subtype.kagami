mixin Figure3D {
	fn volume => area * depth
}

protocol PFigure3D {
	get area
	get depth
	get volume
}

class Cube(width float) {
	get area => width ^ 2
	get depth => width
}
does PFigure3D
mix Figure3D

class Cylinder(radius int, hide depth float) {
	get area => math.pi * radius ^ 2
	get depth => depth
}
does PFigure3D
mix Figure3D

