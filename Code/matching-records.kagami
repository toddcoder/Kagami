open sys

class Couple(him String, her String);

let couples = [
	Couple("Brad", "Angela"), Couple("Becks", "Posh"),
	Couple("Chris", "Gwyneth"), Couple("Michael", "Catherine")
]

match findDavid()
	| (Couple(x, "Posh"), tail) return !x
	| (_, tail) return findDavid(tail)
	| [] return f"Couldn't find David"

let `david = findDavid(couples)
if `david is !david {
	println(david)
}
else {
	println(`david)
}