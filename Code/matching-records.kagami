open sys

record Couple(him String, her String)

let couples = [
	Couple("Brad", "Angela"), Couple("Becks", "Posh"),
	Couple("Chris", "Gwyneth"), Couple("Michael", "Catherine")
]

func findDavid()
	when (Couple(x, "Posh"), tail) return !x
	when (_, tail) return findDavid(tail)
	when [] return f"Couldn't find David"

let `david = findDavid(couples)
if `david is !david {
	println(david)
}
else {
	println(`david)
}