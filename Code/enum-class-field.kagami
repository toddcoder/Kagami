open sys

enum Rank {
	| Ace = 1
	| Two
	| Three
	| Four
	| Five
	| Six
	| Seven
	| Eight
	| Nine
	| Ten
	| Jack
	| Queen
	| King
	func description() string {
		match class {
			| Ace return "ace"
			| Jack return "jack"
			| Queen return "queen"
			| King return "king"
			| _ return class.ordinal
		}
	}
}
println(Ace.description())
println(Seven.description())