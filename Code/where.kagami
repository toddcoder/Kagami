open sys

#pragma ALLOW_PRINT_STATEMENT true

fn distance(x1, y1, x2, y2) {
	var dx = x2 - x1
	var dy = y2 - y1
	var dsquared = dx ^ 2 + dy ^ 2
	return where rslt in rslt = math.sqrt(dsquared)
}

fn area(radius) => math.pi * radius

fn circleArea(xc, yc, xp, yp) => where rslt in radius = distance(xc, yc, xp, yp), rslt = area(radius)

println circleArea(1, 5, 3, 4)