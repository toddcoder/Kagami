open sys

class ChecksumAccumulator {
	hide var sum = 0

	fn add(b byte) => sum += b

	fn checksum() int => not (sum and 0xff) + 1
}
static {
	hide let cache = {string:int} {(s)
		let acc = ChecksumAccumulator()
		for c in s do acc.add(c.ord.b)
		return acc.checksum()
	}
	fn calculate(s string) int => cache[s]
}

println(ChecksumAccumulator.calculate("foobar"))