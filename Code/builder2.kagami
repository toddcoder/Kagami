#pragma ALLOW_PRINT_STATEMENT true

builder intParsing(s1 string, s2 string) {
	let i1 = int.parse(s1)
	let i2 = int.parse(s2)
	do {for i in i1 downto i2 println i}
	return i1 * i2
}

let i1 = intParsing("153", "22")
if i1 is !int1 {
	println int1
}
else {
	println i1
}

let i2 = intParsing("153", "xx")
if i2 is !int2 {
	println int2
}
else {
	println i2
}