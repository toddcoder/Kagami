open sys

var totalPrice = 22
var change = 100 - totalPrice

| (quarters, use change) = change /% 25
| (dimes, use change) = change /% 10
| (nickels, use change) = change /% 5
var cents = change

println("The change is:")
println(quarters, "Quarters")
println(dimes, "Dimes")
println(nickels, "Nickels")
println(cents, "Cents")