open sys

#pragma ALLOW_PRINT_STATEMENT true

mixin Movement {
	fn run() => println "I'm running!"
	fn walk() => println "I'm walking a bit briskly!"
	fn crawl() => println "I'm so slowwww!"
}

class Man {
	fn jump() => println "I'm bipedal and I can jump like a fool!"
}
mix Movement

class Sloth {
	fn flop() => println $"It's all a lie...all I can do is flop around."
}
mix Movement

var mister_man = Man()
mister_man.run()

var mister_slothy = Sloth()
mister_slothy.crawl()