open sys

#pragma ALLOW_PRINT_STATEMENT true

mixin Movement {
	func run() => println "I'm running!"
	func walk() => println "I'm walking a bit briskly!"
	func crawl() => println "I'm so slowwww!"
}

class Man {
	func jump() => println "I'm bipedal and I can jump like a fool!"
}
mixin Movement

class Sloth {
	func flop() => println $"It's all a lie...all I can do is flop around."
}
mixin Movement

var mister_man = Man()
mister_man.run()

var mister_slothy = Sloth()
mister_slothy.crawl()