open sys

implicit Int(ary Array) {
	var accum = 1
	for i in ary {
		for c in i.string {
			if '0' <= c <= '9' {
				var value = c.ord - '0'.ord
				accum = accum * 10 + value
			}
			else {
				return f"Character not between 0 and 9"
			}
		}
	}
	return accum
}

var i int = ["153", "123", "111"]
println($"Value is (i)")