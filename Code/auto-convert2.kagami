open sys

class Point(x int, y int) {
	get string => $"Point\($x, $y)"
}

implicit Point(a Array) => Point(a[0], a[1])
implicit Point(d Dictionary) => Point(d{"x"}, d{"y"})

let topLeft = Point(0, 0)
let botRight Point = [100, 100]
let center Point = {x: 50, y: 50}

println(topLeft)
println(botRight)
println(center)