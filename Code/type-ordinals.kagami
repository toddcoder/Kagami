open sys

type Planet {| Mercury = 1, Venus, Earth, Mars, Jupiter, Saturn, Uranus, Neptune}

let positionToFind = 11
if Planet.values[positionToFind] is ?somePlanet {
	match somePlanet {
		| Earth <- println("Mostly harmless")
		| _ <- println("Not a safe place for humans")
	}
}
else {
	println($"There isn't a planet at position (positionToFind)")
}