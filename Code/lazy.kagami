open sys

class Heavy(var size = 10) {
	println($"Creating Heavy with (size)")
	get string => $"Heavy\(size=(size))"
}

class AsNeeded(var value int) {
	lazy heavy1 = Heavy()
	lazy heavy2 = Heavy(value)
	println("Created AsNeeded")
}

var asNeeded = AsNeeded(1000)
println(asNeeded.heavy1)
println(asNeeded.heavy2)