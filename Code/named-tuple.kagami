open sys

#pragma ALLOW_PRINT_STATEMENT true

let list1 = [1 to 10]
let list2 = 1 :: 2 :: 3 :: []
let list5 = [(index, index ^ 2, index ^ 3) for index in ^^5]
let list3 = [1 to 10]
let list6 = [a ^ 2 for a in 1 to 10]
let list4 = ['a' to 'm']
let list7 = [a for a in 1 to 100 if a %% 3 and a %% 5]
let list8 = [a to a + 3 for a in 1 to 3]

for list in [list1, list2, list3, list4, list5, list6, list7, list8] println $"The list: (~list)"

println ~[(single: index, squared: index ^ 2, cubed: index ^ 3) for index in ^^5]