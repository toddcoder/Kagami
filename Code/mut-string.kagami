open sys

let digitNames = {0: "Zero", 1: "One", 2: "Two", 3: "Three", 4: "Four",5: "Five", 6: "Six", 7: "Seven", 8: "Eight", 9: "Nine"}
let numbers = [16, 58, 510]
let strings = numbers map (number) -> {
	var n = number
	var output = m""
	loop {
		output.insert(at: 0, value: digitNames[n % 10]&)
		n = n div 10
	} while n > 0
	return output.string
}
println(strings)