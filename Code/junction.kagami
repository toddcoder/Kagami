open sys

let diceSum = 7
if any[7, 11] == diceSum {
	println("natural")
}

println(one["a", "b", "c"] == "a")

let j = any[1, 2]
if j + 1 == 3 {
	println("yes")
}

var k = +any["not a number", "42", "2.1"]
println(k)

let odd = any[1, 3, 5]
let even = any[2, 4, 6]
let merged = odd + even
if merged == 11 {
	println("found 11")
}

let array = [merged]
println(~array)

func greet(greeting, name) => $"(greeting), (name)"
println(any["Hello", "Bye"], any["Todd", "Debra"])