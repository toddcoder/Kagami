open sys

class Size {
	var width = 0.0
	var height = 0.0
	func string <- $"Size\((width), (height))"
}

class Point {
	var x = 0.0
	var y = 0.0
	func string <- $"Point\((x), (y))"
}

class Rect {
	var origin = Point()
	var size = Size()
	func string <- $"Rect\((origin), (size))"
}
init(origin: _ Point, size: _ Size) <- Rect(){origin = origin, size = size}
init(center: _ Point, size: _ Size) {
	let originX = center.x - size.width / 2
	let originY = center.y - size.height / 2
	return Rect(){origin = Point(){x = originX, y = originY}, size = size}
}

let originRect = Rect(origin: Point(){x = 2.0, y = 2.0}, size: Size(){width = 5.0, height = 5.0})
println(originRect)
let centerRect = Rect(center: Point(){x = 4.0, y = 4.0}, size: Size(){width = 3.0, height = 3.0})
println(centerRect)