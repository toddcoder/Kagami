open sys

#pragma ALLOW_PRINT_STATEMENT true

class Coffee(name, strength = 1) {
	func brew() => println $"brewing $name"
	func pour(amount = 1) {
		if amount == 1 {
			return "Poured a single cup"
		}
		else {
			return $"Poured $amount cups"
		}
	}
}

class MaxgoodHouse(name, strength = 0) : Coffee(name, strength) {
	let brand = "Maxgood House"

	override func brew() => println $"Brewing $brand $name"
	override func pour(amount = 0) => $"(super.pour(amount)), but it sucks"
}

let boring = MaxgoodHouse("Boring")
boring.brew()
println boring.pour()