open sys

var lines = ["ONE 1 I", "TWO 2 I", "#START", "THREE:3:III", "FOUR:4:IV", "FIVE:5:V", "#STOP", "SIX 6 VI", "SEVEN 7 VII"]
var regex = x"/s+"
for line in lines {
	match line {
		when "#START" => regex = x"':'"
		when "#STOP" => regex = x"' '"
		when _ => println(line.words(regex: regex){2:1}.one())
	}
}