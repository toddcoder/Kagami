open sys

var lines = ["ONE 1 I", "TWO 2 I", "#START", "THREE:3:III", "FOUR:4:IV", "FIVE:5:V", "#STOP", "SIX 6 VI", "SEVEN 7 VII"]
var regex = ${ ' ' }
for line in lines {
	match line {
		| "#START" => regex = ${ ':' }
		| "#STOP" => regex = ${ ' ' }
		| _ => println(line.split(regex){2:1}.one())
	}
}