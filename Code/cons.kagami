open sys

#pragma ALLOW_PRINT_STATEMENT true

var xs = [153, 49, 123, 73]

while xs != [] {
	println "head", ~xs.head
	println "tail", ~xs.tail
	printline
	xs = xs.tail
}

match isort(xs) {
	|[] return []
	|h :: t return insert(h, isort(t))
}

match insert(x, xs) {
	|(x, []) return [x]
	|(x, h :: t) if x <= h return x :: xs
	|(x, h :: t) return h :: insert(x, t)
}

xs = [153, 49, 123, 73]

println isort(xs)