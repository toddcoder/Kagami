open sys

var i = 0;
fn term(x) {
	println($"term (i++)")
	return x
}

println("T & T", term(true) and term(true))
println("F & F", term(false) and term(false))
println("T & F", term(true) and term(false))

println()
i = 0
println("T | T", term(true) or term(true))
println("F | F", term(false) or term(false))
println("F | T", term(false) or term(true))

println()
i = 0
println("T ^ T", term(true) xor term(true))
println("F ^ F", term(false) xor term(false))
println("F ^ T", term(false) xor term(true))