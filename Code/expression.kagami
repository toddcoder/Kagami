type Expr {
	| Binary(s, e1, e2)
	| Variable(s)
	| Constant(i)
}

let v = Binary("+", Variable("x"), Constant(10))

let variables = {x: 10, y: 42}

match eval(expr Expr) {
	| Binary("+", e1, e2) return eval(e1) + eval(e2)
	| Binary("-", e1, e2) return eval(e1) - eval(e2)
	| Variable(v) return variables[v]&
	| Constant(i) return i
}

eval(v)