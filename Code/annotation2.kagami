open sys

#pragma ALLOW_PRINT_STATEMENT true

annotation Grab(sel Selector, lam lambda, x int) {
	println $"Invoking $sel.name"
	lam(x)
}

annotation Wrap(sel Selector, f lambda) {
	let g = {(x)
		let r = f(x)
		println r
		return r
	}
	println sel
	sel.assign(g)
}

@Grab(10)
fn foobar(x int) => println x


@Wrap
fn foobaz(s string) => s + s

foobaz("?")